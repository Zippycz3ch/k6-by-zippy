        {
          "datasource": {
            "type": "influxdb",
            "uid": "P5697886F9CA74929"
          },
          "query": "// Release A p75\r\np75_r1 = from(bucket: \"k6\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) =>\r\n    r._measurement == \"http_req_duration\" and\r\n    r._field == \"value\" and\r\n    r[\"group\"] != \"::setup\" and\r\n    r[\"group\"] != \"::teardown\" and\r\n    r[\"release\"] =~ /${release:regex}/ and\r\n    r[\"scenario\"] =~ /${scenario:regex}/ and\r\n    r[\"testName\"] =~ /${testName:regex}/\r\n  )\r\n  |> group(columns: [\"name\", \"testName\"])\r\n  |> quantile(q: 0.75, method: \"exact_mean\")\r\n  |> map(fn: (r) => ({r with p75_r1: r._value}))\r\n  |> drop(columns: [\"_value\"])\r\n\r\n// Release B p75\r\np75_r2 = from(bucket: \"k6\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) =>\r\n    r._measurement == \"http_req_duration\" and\r\n    r._field == \"value\" and\r\n    r[\"group\"] != \"::setup\" and\r\n    r[\"group\"] != \"::teardown\" and\r\n    r[\"release\"] =~ /${release1:regex}/ and\r\n    r[\"scenario\"] =~ /${scenario:regex}/ and\r\n    r[\"testName\"] =~ /${testName:regex}/\r\n  )\r\n  |> group(columns: [\"name\", \"testName\"])\r\n  |> quantile(q: 0.75, method: \"exact_mean\")\r\n  |> map(fn: (r) => ({r with p75_r2: r._value}))\r\n  |> drop(columns: [\"_value\"])\r\n\r\n// Join both releases\r\njoined = join(tables: {r1: p75_r1, r2: p75_r2}, on: [\"name\", \"testName\"])\r\n\r\njoined\r\n  |> map(fn: (r) => ({\r\n      r with\r\n      diff_p75: r.p75_r2 - r.p75_r1,\r\n      diff_p75_p: if r.p75_r1 > 0.0 then ((r.p75_r2 - r.p75_r1) / r.p75_r1) * 100.0 else 0.0\r\n  }))\r\n  |> rename(columns: {\r\n    name: \"Endpoint\",\r\n    testName: \"Test ID\",\r\n    p75_r1: \"R1 p(75)\",\r\n    p75_r2: \"R2 p(75)\",\r\n    diff_p75: \"Diff p(75)\",\r\n    diff_p75_p: \"Diff %\"\r\n  })\r\n  |> keep(columns: [\"Test ID\", \"Endpoint\", \"R1 p(75)\", \"R2 p(75)\", \"Diff p(75)\", \"Diff %\"])\r\n  |> group(columns: [])\r\n  |> yield(name: \"comparison\")",
          "refId": "A"
        }
      ],
      "title": "HTTP Request Duration Release Comparison - p75 Percentiles",
      "transformations": [
